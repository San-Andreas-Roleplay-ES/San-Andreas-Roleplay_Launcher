# API de los builds release (manifest, métricas, eventos y lista del caché).
# La lee backend/build.rs al compilar el backend: cambiarla exige recompilar. Debe ser https.
VITE_API_URL=https://api.gta-rol.com

# Solo en dev (`yarn dev`): la API local. Una variable de entorno con el mismo
# nombre la reemplaza sin recompilar.
DEV_API_URL=http://localhost:3333

# Clave que identifica al launcher ante la API (header X-Launcher-Key). Debe
# coincidir con LAUNCHER_KEY de la API. Va horneada en el binario del backend
# (nunca en el frontend) y solo se envía a la API.
LAUNCHER_KEY=

# Game server
VITE_GAME_SERVER_IP=135.148.128.72
VITE_GAME_SERVER_PORT=7777
VITE_GAME_SERVER_LOCATION=Miami

# Subcarpeta dentro de Documents/GTA San Andreas User Files/SAMP/cache/
# que se considera "el caché del servidor". Tipicamente: <ip>.<puerto>.
# También lo lee backend/build.rs al compilar el backend: cambiarlo exige recompilar.
VITE_GAME_CACHE_FOLDER=135.148.128.72.7777

# Solo en dev (`yarn dev`): carpeta que el selector "Cambiar ubicación" propone
# por defecto. En producción se propone la ruta típica de Rockstar si existe.
DEV_GTA_PATH=C:\Program Files (x86)\Rockstar Games\GTA San Andreas

# Solo en dev: carpeta que reemplaza a la del caché del servidor, para probar la
# sincronización sin tocar la real (que borra archivos viejos). Una variable de
# entorno con el mismo nombre la reemplaza. Los builds release la ignoran.
# DEV_CACHE_DIR=C:\tmp\sarp-cache

# Solo en dev: carpetas de GTA (separadas por ;) que reemplazan TODAS las
# fuentes de la detección automática (registro, Steam, historial...), para
# probarla sin que adopte una instalación real. Un ";" solo significa "no se
# encontró nada". Una variable de entorno con el mismo nombre la reemplaza.
# Los builds release la ignoran.
# DEV_GTA_CANDIDATES=C:\tmp\gta\A;C:\tmp\gta\B

# Solo en dev: clave pública minisign (o la ruta de un archivo que la tenga)
# con la que se verifica el catálogo de mods en lugar de la del updater
# (plugins.updater.pubkey). Para probar con catálogos firmados con una clave de
# prueba (`yarn tauri signer generate`). Una variable de entorno con el mismo
# nombre la reemplaza. Los builds release la ignoran.
# DEV_MODS_PUBKEY=C:\tmp\mods-test\test.key.pub
