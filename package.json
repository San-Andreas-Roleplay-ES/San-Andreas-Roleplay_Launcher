{
  "name": "san-andreas-roleplay-launcher",
  "version": "1.1.0",
  "description": "San Andreas Roleplay official launcher",
  "author": "San Andreas Roleplay",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "vue-tsc --noEmit && vite build",
    "build:dir": "tauri build --no-bundle",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint . --ext .vue,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .vue,.ts,.tsx --max-warnings=0",
    "format": "prettier --write \"frontend/**/*.{vue,ts,tsx,css,json}\" \"*.{ts,json,md}\"",
    "format:check": "prettier --check \"frontend/**/*.{vue,ts,tsx,css,json}\" \"*.{ts,json,md}\"",
    "typecheck": "vue-tsc --noEmit",
    "polish": "yarn format && yarn lint && yarn typecheck",
    "reset": "node scripts/reset.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "pinia": "^2.2.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.2.1",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@primevue/themes": "^4.2.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-vue": "^5.1.4",
    "eslint": "^9.12.0",
    "eslint-plugin-vue": "^9.29.0",
    "globals": "^17.6.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vue-tsc": "^2.1.6"
  }
}
